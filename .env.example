# Required
FLUXER_TOKEN=
FLUXER_INSTANCE_URL=https://chat.example.org
# Optional overrides (leave blank to discover)
FLUXER_API_URL=
FLUXER_GATEWAY_URL=
GM_ROLE_NAME=GM
COMMAND_PREFIX=!
LOG_LEVEL=INFO
# Blank = the rules file packaged in the image (src/green_oaks_bot/rulesets/green_oaks.toml)
RULES_FILE=
# Where users can get the source (AGPL-3.0 network-use offer); set to your fork if modified
SOURCE_URL=https://github.com/tznkai/green-oaks-bot
# Docker Compose only: the uid:gid the container runs as (default 1000:1000).
# Set these to the output of `id -u` and `id -g` if ./data belongs to another user.
# UID=1000
# GID=1000
